# Copy to `.env` — it is gitignored, and real environment variables always win.
#
# Claude (default provider). Key from https://console.anthropic.com -> API keys.
# ANTHROPIC_API_KEY=sk-ant-...
# PPT_HARNESS_MODEL=claude-opus-4-8

# Or DeepSeek. Key from https://platform.deepseek.com -> API keys. The endpoint follows
# from the model name, so no base URL is needed.
# Models this key can see: deepseek-v4-flash, deepseek-v4-pro
DEEPSEEK_API_KEY=sk-...
PPT_HARNESS_MODEL=deepseek-v4-flash
# Or any OpenAI-compatible endpoint. Setting a base URL selects that path.
# PPT_HARNESS_BASE_URL=http://127.0.0.1:8000/v1
# PPT_HARNESS_MODEL=mlx-community/Qwen3.5-4B-MLX-4bit
# OPENAI_API_KEY=not-needed

# Which renderer produces previews and fidelity references: `powerpoint` or `libreoffice`.
# Unset means PowerPoint where installed, LibreOffice otherwise — and a PowerPoint that is
# installed but refuses to convert falls back automatically, because "installed" and
# "usable" turned out to be different states. Set this to pin one: the two engines break
# lines and substitute fonts differently, so a fidelity figure is only comparable to another
# measured on the same engine.
# PPT_HARNESS_RENDERER=libreoffice
