# Decks. Large, usually confidential, and belonging to whoever made them. The suite runs
# against tests/fixtures/demo.pptx — built by scripts/make_demo_deck.py and committed
# because it is 47 KB and carries the awkward parts on purpose. Point the tests somewhere
# else with PPT_HARNESS_FIXTURE rather than by dropping a deck in the root.
*.pptx
*.pptm
*.ppt
*.potx
!tests/fixtures/*.pptx

# Secrets. `.env.example` is committed and shows the shape; `.env` never is.
.env
.env.local

# Harness working files: preview renders, exported decks, the renderer lock, and the
# per-user preference store. All reproducible or personal, none of it shared.
.harness/*
fidelity-out/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Generated: measured margins, written by the fidelity corpus rather than by hand.
ppt_harness/fidelity/margins.generated.json

# Editors and OS
.DS_Store
.idea/
*.swp